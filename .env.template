# Hallucinations.cloud Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# === AI MODEL API KEYS ===
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROK_API_KEY=your_grok_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# === STRIPE PAYMENT KEYS ===
STRIPE_LIVE_SECRET_KEY=your_stripe_live_key_here
STRIPE_TEST_SECRET_KEY=your_stripe_test_key_here
STRIPE_LIVE_PUBLISHABLE_KEY=your_stripe_live_publishable_key_here
STRIPE_TEST_PUBLISHABLE_KEY=your_stripe_test_publishable_key_here

# === TWILIO SMS AUTHENTICATION ===
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# === GMAIL SIGN-IN NOTIFICATIONS ===
# Gmail App Password (NOT your regular Gmail password)
# Get one at: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# === SUPABASE DATABASE ===
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here